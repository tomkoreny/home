 QVariantMap HyprlandWorkspace::lastIpcObject() const { return this->mLastIpcObject; }
 
+qint32 workspaceIdFromObject(const QVariantMap& object) {
+	if (object.contains("id")) return object.value("id").value<qint32>();
+	if (object.value("type").toString() == "numbered") {
+		return workspaceIdFromSelector(object.value("address").toString().toUtf8());
+	}
+	return -1;
+}
+
+qint32 workspaceIdFromSelector(QByteArrayView selector) {
+	bool ok = false;
+	auto id = selector.toInt(&ok);
+	return ok ? id : -1;
+}
