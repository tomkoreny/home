{
  "manifest_version": 3,
  "name": "Play in mpv",
  "version": "1.0.0",
  "description": "Explicitly hand off a YouTube or Twitch video to mpv.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Play in mpv (Alt+Shift+M)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtu.be/*",
        "https://twitch.tv/*",
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
